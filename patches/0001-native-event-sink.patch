+pub type NativeEventSink = Box<dyn Fn(AppEvent) + Send + Sync + 'static>;
+#[cfg(all(feature = "native-events", not(feature = "tauri")))]
+static NATIVE_EVENT_SINK: std::sync::OnceLock<NativeEventSink> =
+    std::sync::OnceLock::new();
 pub struct EventState {
     /// Tauri app
     #[cfg(feature = "tauri")]
@@ -83,6 +90,26 @@ impl EventState {
         Ok(())
     }
 
+    #[cfg(all(feature = "native-events", not(feature = "tauri")))]
+    pub(crate) fn try_get() -> Option<Arc<Self>> {
+        EVENT_STATE.get().cloned()
+    }
+
+    /// Route backend events to a native (non-webview) frontend.
+    /// Call once, before `EventState::init` / `State::init`.
+    #[cfg(all(feature = "native-events", not(feature = "tauri")))]
+    pub fn set_native_sink(sink: NativeEventSink) {
+        let _ = NATIVE_EVENT_SINK.set(sink);
+    }
+
+    #[cfg(all(feature = "native-events", not(feature = "tauri")))]
+    pub fn send(&self, event: AppEvent) -> crate::Result<()> {
+        if let Some(sink) = NATIVE_EVENT_SINK.get() {
+            sink(event);
+        }
+        Ok(())
+    }
